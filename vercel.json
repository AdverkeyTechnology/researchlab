{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "functions": { "api/index.js": { "maxDuration": 60, "includeFiles": "{lib/**,migrations/**,push.sh}" } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/auth/:path*", "destination": "/api/index" },
    { "source": "/r/:id/raw", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/push.sh", "destination": "/api/index" },
    { "source": "/((?!assets/|favicon.svg).*)", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"same-origin"}
  ]}]
}
